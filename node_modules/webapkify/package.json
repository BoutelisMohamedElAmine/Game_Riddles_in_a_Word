{
  "name": "webapkify",
  "version": "0.1.6",
  "description": "Wrap any client-side web application as a native Android APK using WebView.",
  "license": "MIT",
  "type": "module",
  "bin": {
    "webapkify": "./dist/index.js"
  },
  "types": "./dist/index.d.ts",
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "keywords": [
    "webapkify",
    "webview",
    "android",
    "apk",
    "cli",
    "tool",
    "webapp",
    "packaging"
  ],
  "engines": {
    "node": ">=20.0.0"
  },
  "dependencies": {
    "sharp": "^0.34.5"
  },
  "devDependencies": {
    "@types/node": "^25.9.1",
    "tsx": "^4.22.3",
    "typescript": "^6.0.3"
  },
  "scripts": {
    "dev": "tsx src/index.ts",
    "start": "node dist/index.js",
    "build": "tsc -p tsconfig.json",
    "check": "pnpm pack --dry-run"
  }
}